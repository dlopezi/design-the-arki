# Copy to .env.local (or set in the hosting provider) to configure optional services.
# Cookieless analytics: Plausible (script + domain) or Umami (script + website id). Leave empty to disable.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_WEBSITE_ID=
# Where "Send feedback" points. Defaults to GitHub issues of dlopezi/archi-game.
VITE_FEEDBACK_URL=
