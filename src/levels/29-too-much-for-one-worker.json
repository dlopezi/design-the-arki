{
  "id": "29-too-much-for-one-worker",
  "chapter": "Events",
  "title": "Too much for one Worker",
  "brief": "The network grows: ten posts arrive each second, and one Worker instance takes four. Notifications and Search each need three instances. But a Topic is split into Partitions, and only one instance of a Subscription reads a Partition at a time: with two Partitions, a third instance has nothing to read and stands idle. Raise the Partitions of the Topic in the Build Phase, then add the instances. Each Partition costs a little each month.",
  "requirements": {
    "p95Ms": 300,
    "maxErrorRate": 0.01
  },
  "allowedComponents": [
    "appServer",
    "database",
    "topic",
    "worker"
  ],
  "componentOptions": {
    "appServer": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 1
    },
    "database": {
      "sizes": [
        "small"
      ]
    },
    "worker": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 4
    },
    "topic": {
      "limits": {
        "partitions": 6
      }
    }
  },
  "guidedHint": "Each Worker has three instances, but the Topic has only two Partitions, so one instance of each stands idle. Select the Topic and raise its Partitions to 3 before the wave: Partitions are locked once the users arrive.",
  "play": {
    "startMoney": 600,
