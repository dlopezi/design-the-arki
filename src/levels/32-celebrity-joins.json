{
  "id": "32-celebrity-joins",
  "chapter": "Events",
  "title": "The celebrity joins",
  "brief": "Launch day for the social network, and everything happens at once. 500 requests arrive each second: 200 are junk with no token, 290 are feed reads and 10 are posts. 20 s into the wave a celebrity joins: for 20 s, 3 posts in 10 are theirs, each followed by 3,000 people (millions in real life), and writing every one of them into each follower's feed floods the Database. At 45 s a Notifications Worker instance goes down. Use what you have learned: an API Gateway at the door, a load balancer and two app servers, a cache in front of the Database for the feed reads, a Topic with a Partition for each working Worker instance, a spare instance, and a Celebrity Limit on the Feed Worker.",
  "durationS": 70,
  "traffic": [
    {
      "fromS": 0,
      "toS": 70,
      "rps": 500
    }
  ],
  "requirements": {
    "p95Ms": 300,
    "maxErrorRate": 0.01
  },
  "budget": 900,
  "starCostThresholds": [
    800,
    700
  ],
  "allowedComponents": [
    "apiGateway",
    "loadBalancer",
    "appServer",
    "cache",
    "database",
    "topic",
    "worker"
  ],
  "componentOptions": {
    "appServer": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 2
    },
    "database": {
      "sizes": [
        "small"
      ]
    },
    "cache": {
      "limits": {
        "ttlS": 120
      }
    },
    "worker": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 4
    },
    "topic": {
      "limits": {
        "partitions": 6
      }
    }
  },
  "guidedHint": "Everything is built, but the Feed Worker has no Celebrity Limit, so each celebrity post is written into 3,000 feeds. Select the Feed Worker and set its Celebrity Limit to 1000 followers: the celebrity's posts are then merged when a feed is read. Keep the spare Notifications instance: it takes over when one goes down.",
  "play": {
    "startMoney": 900,
    "wave": {
      "rps": 500,
      "lengthS": 70,
      "mix": {
        "invalid": 0.4,
        "post": 0.02,
        "readFeed": 0.58
      }
    },
    "incident": {
      "atS": 45,
      "componentType": "worker"
    },
    "starMoney": [
      150,
      330
    ],
    "subscriptions": {
      "notifications": {
        "maxLagS": 10
      },
      "feed": {
        "maxLagS": 20
      }
    },
    "feed": {
      "subscription": "feed",
      "followers": 15,
      "follows": 20,
      "celebrity": {
        "atS": 20,
        "lengthS": 20,
        "share": 0.3,
        "followers": 3000,
        "followed": 1
      }
    }
  },
