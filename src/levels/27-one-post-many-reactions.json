{
  "id": "27-one-post-many-reactions",
  "chapter": "Events",
  "title": "One post, many reactions",
  "brief": "Your new social network is live. When someone posts, three systems must react: Notifications tells their followers, Search indexes the post, and Analytics counts it. Three posts arrive each second, and each system needs every one of them. A Message Queue gives each Message to one Worker only, so each system would miss most posts. A Topic keeps a copy of every post for each Subscription, and each Subscription has its own Worker.",
  "requirements": {
    "p95Ms": 300,
    "maxErrorRate": 0.01,
    "maxQueueAgeS": 30
  },
  "allowedComponents": [
    "appServer",
    "database",
    "messageQueue",
    "topic",
    "worker"
  ],
  "componentOptions": {
    "appServer": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 1
    },
    "database": {
      "sizes": [
        "small"
      ]
    },
    "worker": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 2
    }
  },
  "guidedHint": "The Topic and one Worker for each Subscription are ready, but no post reaches the Topic. Connect the app server to the Topic: every Subscription then gets its own copy of each post.",
  "play": {
    "startMoney": 400,
    "wave": {
      "rps": 15,
      "lengthS": 45,
      "mix": {
        "post": 0.2,
        "readFeed": 0.8
      }
    },
    "starMoney": [
      100,
      180
    ],
