{
  "id": "30-hot-partition",
  "chapter": "Events",
  "title": "Hot partition",
  "brief": "Ten posts arrive each second, over three Partitions read by three Worker instances. But the Topic uses the country as its Partition Key, and most of your users live in one country: 60% of the posts land in one Partition, and the instance that reads it cannot keep up while the others wait. More Partitions or more instances do not help, because one country always goes to one Partition. Pick a better Partition Key in the Build Phase: the user id has many values used evenly.",
  "requirements": {
    "p95Ms": 300,
    "maxErrorRate": 0.01
  },
  "allowedComponents": [
    "appServer",
    "database",
    "topic",
    "worker"
  ],
  "componentOptions": {
    "appServer": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 1
    },
    "database": {
      "sizes": [
        "small"
      ]
    },
    "worker": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 4
    },
    "topic": {
      "limits": {
        "partitions": 6
      }
    }
  },
  "guidedHint": "Partition 1 is hot: the country key sends 60% of the posts there, more than one instance can take. Select the Topic and pick User id as its Partition Key before the wave starts.",
  "play": {
    "startMoney": 600,
    "wave": {
