{
  "id": "21-far-away-videos",
  "chapter": "Edge",
  "title": "Far away videos",
  "brief": "Your video app goes global, and one video goes viral: 280 downloads of the video file and 120 page views arrive every second. Every download is served by Object Storage, which can send out only so many big files each second, so it fills up and downloads start to fail. Put a CDN in front of it. The CDN answers a share of the downloads close to the users, and only the rest reaches Object Storage. Connect the users to the CDN for downloads, and the CDN to Object Storage.",
  "requirements": {
    "p95Ms": 300,
    "maxErrorRate": 0.01
  },
  "allowedComponents": [
    "cdn",
    "loadBalancer",
    "appServer",
    "database",
    "objectStorage"
  ],
  "componentOptions": {
    "appServer": {
      "sizes": [
        "medium"
      ],
      "maxInstances": 3
    },
    "database": {
      "sizes": [
        "small"
      ]
    },
    "cdn": {
      "limits": {
        "ttlS": 120
      }
    }
  },
  "guidedHint": "Object Storage can send out only so many big files each second, and a viral video passes that limit. Connect the users straight to the CDN: it answers a share of the downloads at the edge, and only the rest goes on to Object Storage.",
  "play": {
