        "medium"
      ],
      "maxInstances": 4
    }
  },
  "guidedHint": "The primary database is full of reads. Add Read Replicas: the app server sends the reads to them, and the primary keeps the writes. Reads are 9 in 10 requests, so one replica is not enough.",
  "play": {
